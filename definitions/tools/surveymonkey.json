{
  "name": "surveymonkey",
  "type": "service",
  "title": "SurveyMonkey",
  "category": "Forms & Signing",
  "description": "SurveyMonkey surveys and responses (OAuth token)",
  "auth": {
    "credentials": [
      {
        "source": {"field": "access_token"},
        "inject": {"type": "env", "env_var": "SURVEYMONKEY_ACCESS_TOKEN"}
      }
    ]
  }
}
