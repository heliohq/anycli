{
  "name": "youtube",
  "type": "service",
  "title": "YouTube",
  "category": "Social & Ads",
  "description": "YouTube as a tool (OAuth 2.0 user access token)",
  "auth": {
    "credentials": [
      {
        "source": {"field": "access_token"},
        "inject": {"type": "env", "env_var": "YOUTUBE_ACCESS_TOKEN"}
      }
    ]
  }
}
