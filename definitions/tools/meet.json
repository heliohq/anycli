{
  "name": "meet",
  "type": "service",
  "title": "Google Meet",
  "category": "Productivity",
  "description": "Google Meet as a tool (user access token)",
  "auth": {
    "credentials": [
      {
        "source": {"field": "access_token"},
        "inject": {"type": "env", "env_var": "MEET_ACCESS_TOKEN"}
      }
    ]
  }
}
