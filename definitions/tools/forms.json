{
  "name": "forms",
  "type": "service",
  "title": "Google Forms",
  "category": "Forms & Signing",
  "description": "Google Forms as a tool (user access token)",
  "auth": {
    "credentials": [
      {
        "source": {"field": "access_token"},
        "inject": {"type": "env", "env_var": "FORMS_ACCESS_TOKEN"}
      }
    ]
  }
}
