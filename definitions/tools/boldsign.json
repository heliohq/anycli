{
  "name": "boldsign",
  "type": "service",
  "title": "BoldSign",
  "category": "Forms & Signing",
  "description": "BoldSign e-signature as a tool (OAuth 2.0 access token)",
  "auth": {
    "credentials": [
      {
        "source": {"field": "access_token"},
        "inject": {"type": "env", "env_var": "BOLDSIGN_ACCESS_TOKEN"}
      }
    ]
  }
}
