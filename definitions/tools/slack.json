{
  "name": "slack",
  "type": "service",
  "title": "Slack",
  "category": "Productivity",
  "description": "Slack as a tool (bot token)",
  "auth": {
    "credentials": [
      {
        "source": {"field": "access_token"},
        "inject": {"type": "env", "env_var": "SLACK_BOT_TOKEN"}
      }
    ]
  }
}
