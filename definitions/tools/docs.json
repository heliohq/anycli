{
  "name": "docs",
  "type": "service",
  "title": "Google Docs",
  "category": "Productivity",
  "description": "Google Docs as a tool (user access token)",
  "auth": {
    "credentials": [
      {
        "source": {"field": "access_token"},
        "inject": {"type": "env", "env_var": "DOCS_ACCESS_TOKEN"}
      }
    ]
  }
}
